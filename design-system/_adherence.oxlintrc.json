{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/game/**",
              "components/menu/**",
              "ui_kits/aplicacoes/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Courier Prime|Darumadrop One|Noto Sans Symbols 2|Shrikhand))/i]",
        "message": "Font not provided by the design system. Available: Courier Prime, Darumadrop One, Noto Sans Symbols 2, Shrikhand."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|rosa|amarelo|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'rosa' | 'amarelo' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checker'] > JSXAttribute > JSXIdentifier[name!=/^(?:palette|cell|width|height|a|b|children|style|key|ref|className|style|children)$/]",
        "message": "<Checker> doesn't accept that prop. Declared props: palette, cell, width, height, a, b, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checker'] > JSXAttribute[name.name='palette'] > Literal[value!=/^(?:classic|duel|rosa|amarelo|soft)$/]",
        "message": "<Checker> palette must be one of 'classic' | 'duel' | 'rosa' | 'amarelo' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoBrand'] > JSXAttribute > JSXIdentifier[name!=/^(?:partner|partnerLogo|layout|tone|size|symbol|style|key|ref|className|style|children)$/]",
        "message": "<CoBrand> doesn't accept that prop. Declared props: partner, partnerLogo, layout, tone, size, symbol, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoBrand'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:inline|stacked)$/]",
        "message": "<CoBrand> layout must be one of 'inline' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoBrand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:preto|creme|duo)$/]",
        "message": "<CoBrand> tone must be one of 'preto' | 'creme' | 'duo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ficha'] > JSXAttribute > JSXIdentifier[name!=/^(?:piece|side|label|size|style|key|ref|className|style|children)$/]",
        "message": "<Ficha> doesn't accept that prop. Declared props: piece, side, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ficha'] > JSXAttribute[name.name='piece'] > Literal[value!=/^(?:rei|dama|torre|bispo|cavalo|peao)$/]",
        "message": "<Ficha> piece must be one of 'rei' | 'dama' | 'torre' | 'bispo' | 'cavalo' | 'peao'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ficha'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:rosa|amarelo|preto)$/]",
        "message": "<Ficha> side must be one of 'rosa' | 'amarelo' | 'preto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSymbol'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|base|size|style|key|ref|className|style|children)$/]",
        "message": "<LogoSymbol> doesn't accept that prop. Declared props: variant, tone, base, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSymbol'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:peao|brinde|tabuleiro)$/]",
        "message": "<LogoSymbol> variant must be one of 'peao' | 'brinde' | 'tabuleiro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSymbol'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:color|negativo|amarelo)$/]",
        "message": "<LogoSymbol> tone must be one of 'color' | 'negativo' | 'amarelo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSymbol'] > JSXAttribute[name.name='base'] > Literal[value!=/^(?:linha|nenhuma|tabuleiro)$/]",
        "message": "<LogoSymbol> base must be one of 'linha' | 'nenhuma' | 'tabuleiro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:piece|drink|note|count|side|dark|style|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: piece, drink, note, count, side, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='piece'] > Literal[value!=/^(?:rei|dama|torre|bispo|cavalo|peao)$/]",
        "message": "<MenuItem> piece must be one of 'rei' | 'dama' | 'torre' | 'bispo' | 'cavalo' | 'peao'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:rosa|amarelo|preto|creme)$/]",
        "message": "<MenuItem> side must be one of 'rosa' | 'amarelo' | 'preto' | 'creme'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieceGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:piece|side|size|outline|style|key|ref|className|style|children)$/]",
        "message": "<PieceGlyph> doesn't accept that prop. Declared props: piece, side, size, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieceGlyph'] > JSXAttribute[name.name='piece'] > Literal[value!=/^(?:rei|dama|torre|bispo|cavalo|peao)$/]",
        "message": "<PieceGlyph> piece must be one of 'rei' | 'dama' | 'torre' | 'bispo' | 'cavalo' | 'peao'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieceGlyph'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:rosa|amarelo|preto|creme)$/]",
        "message": "<PieceGlyph> side must be one of 'rosa' | 'amarelo' | 'preto' | 'creme'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|upper|rotate|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, mono, upper, rotate, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:preto|rosa|amarelo|creme)$/]",
        "message": "<Tag> tone must be one of 'preto' | 'rosa' | 'amarelo' | 'creme'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|tone|size|symbol|symbolVariant|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: layout, tone, size, symbol, symbolVariant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|inline)$/]",
        "message": "<Wordmark> layout must be one of 'stacked' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:preto|creme|duo|rosa|amarelo)$/]",
        "message": "<Wordmark> tone must be one of 'preto' | 'creme' | 'duo' | 'rosa' | 'amarelo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='symbolVariant'] > Literal[value!=/^(?:peao|brinde|tabuleiro)$/]",
        "message": "<Wordmark> symbolVariant must be one of 'peao' | 'brinde' | 'tabuleiro'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
